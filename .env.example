# Modelo das variáveis de ambiente do mile_bag_app.
# Copie para o arquivo do ambiente desejado (.env.development, .env.production)
# e preencha os valores. Arquivos .env.*.local ficam fora do Git.

# Endereço base da mile_bag_api, sem barra no final.
VITE_API_BASE_URL=

# Nome do ambiente exibido numa faixa no topo do app (ex.: Homologação). Vazio em produção: sem faixa.
VITE_AMBIENTE=
# Versão implantada mostrada na faixa (preenchida pelo scripts/implantar.sh do mile_bag_infra).
VITE_VERSAO=
